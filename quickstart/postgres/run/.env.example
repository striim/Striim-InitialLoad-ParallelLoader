# Settings for the loader when it runs from this folder (config.py reads ./.env).
# These are the striim-testing-framework-utility Docker defaults; change them for
# your own Postgres or Striim. quickstart.sh copies this file to .env if .env is absent.

# Source Postgres (probe, split, watermark), as seen from this machine
SOURCE_DB_TYPE=postgres
SOURCE_PG_HOST=localhost
SOURCE_PG_PORT=5432
SOURCE_PG_DATABASE=split_demo
SOURCE_PG_USER=postgres
SOURCE_PG_PASSWORD=striim
SOURCE_PG_SSLMODE=disable

# Striim REST, as seen from this machine
STRIIM_NODE=localhost:9080
STRIIM_ADMIN_USER=admin
STRIIM_ADMIN_PWD=striim

# Target engine for the generated TQL
TARGET_DB_TYPE=postgres
# Striim's DatabaseProviderType for Postgres is "Postgres" (the loader's built-in
# mapping writes "PostgreSQL", which Striim 5.4 rejects).
STRIIM_SOURCE_PROVIDER_TYPE=Postgres
STRIIM_TARGET_PROVIDER_TYPE=Postgres
